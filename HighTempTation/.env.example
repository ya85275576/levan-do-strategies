# =============================================
# HighTempTation 天氣預報校準套利 Bot 配置
# =============================================
# #8 安全：私鑰僅通過環境變量傳遞，永不寫入配置文件
# =============================================

# === 運行模式 ===
DRY_RUN=true
LOG_LEVEL=INFO

# === 掃描配置 ===
SCAN_INTERVAL_SEC=120
MIN_MARKET_LIQUIDITY_USD=500.0

# === 溫度市場搜索關鍵詞 ===
WEATHER_SEARCH_TERMS=highest temperature,high temperature,max temperature,℃,°C,today's high,weather forecast

# === 城市配置 ===
CITIES=Tokyo=35.68,139.69,JP,New York=40.71,-74.01,US,London=51.51,-0.13,GB,Paris=48.86,2.35,FR,Berlin=52.52,13.40,DE,Dubai=25.20,55.27,AE,Sydney=-33.87,151.21,AU,Los Angeles=34.05,-118.24,US,Chicago=41.88,-87.63,US,Istanbul=41.01,28.98,TR

# === Open-Meteo 天氣預報 ===
FORECAST_DAYS=7
FORECAST_MODELS=best_match,ecmwf_seamless,gfs_seamless,icon_seamless,gem_seamless,jma_seamless
DEFAULT_STD_DEV=2.0

# === 集成預報 (ECMWF/GFS/ICON 加權平均) ===
ENSEMBLE_ENABLED=true
ENSEMBLE_MODELS=ecmwf_seamless,gfs_seamless,icon_seamless
ENSEMBLE_WEIGHTS=0.4,0.3,0.3

# === 🌪️ 40成员 ICON Ensemble (PolyWeather 信号源) ===
# 启用后从 Open-Meteo Ensemble API 获取 40-member ICON-EPS 成员级预报
# 支持三种模式:
#   hybrid: 40成员非参数概率优先, 3模型集成兜底
#   ensemble_only: 仅使用40成员概率, 不使用3模型
#   deterministic_only: 仅使用直接预报(不使用任何ensemble)
ENSEMBLE_40_ENABLED=true
ENSEMBLE_40_MODEL=icon_seamless
ENSEMBLE_40_MODE=hybrid
# 40成员ensemble vs Polymarket价格的偏差阈值(通常比CALIBRATION_THRESHOLD更紧)
ENSEMBLE_40_EDGE=0.06
ENSEMBLE_API=https://ensemble-api.open-meteo.com/v1/ensemble

# === 🌐 多模型聚合 + 一致性评分 (Multi-Model Aggregation) ===
# 对标专业天气交易Bot: 对各模型温度预报独立计算桶概率,
# 聚合出 agreement (模型一致性%) + spread (离散度°C),
# 生成 consistency_mult 仓位乘数(默认关闭,需显式开启)
ENABLE_MULTI_MODEL=false
# 参与聚合的模型名称子串(用,分隔,支持模糊匹配)
MULTI_MODEL_MODELS=ecmwf_ifs,gfs_global,icon_global,meteofrance_seamless
# 模型一致性阈值: 单个模型桶概率>=此值计为"同意"
MULTI_MODEL_AGREEMENT_THRESH=0.30
# 离散度惩罚上限(°C): spread达到此值时额外惩罚达最大值
MULTI_MODEL_SPREAD_CAP=15.0

# === #2 偏差校正 ===
BIAS_ENABLED=true
BIAS_HISTORY_DAYS=30
BIAS_MIN_SAMPLES=5

# === #6 數據源冗余交叉驗證 ===
CROSS_VALIDATE_ENABLED=true

# === #4 流動性過濾 ===
MIN_24H_VOLUME_USD=3000
MAX_BID_ASK_SPREAD=0.03

# === 高斯校準 ===
CALIBRATION_THRESHOLD=0.15
MIN_MARKET_PRICE=0.30
MAX_MARKET_PRICE=0.90

# === #5 倉位和風控 ===
POSITION_MIN_USD=200
POSITION_MAX_USD=700
POSITION_CAPITAL_PCT=0.02
NO_TARGET_EXIT_PRICE=0.98
NO_STOP_LOSS_PRICE=0.50
FORCE_EXIT_BEFORE_SETTLEMENT_HOURS=4
FORCE_EXIT_MIN_PROFIT_PCT=0.05
MAX_POSITIONS_PER_CITY_PER_DAY=2
MAX_CONCURRENT_POSITIONS=10
MAX_DAILY_LOSS_PCT=0.05

# === 🌡️ METAR 实时观测数据 ===
# 从 aviationweather.gov 接入各城市 ICAO 机场实时 METAR 温度
# 捕捉提前 1-6 小时的信息时间差
ENABLE_METAR=true
# 自定义 ICAO 映射: City1=ICAO1,City2=ICAO2 (不填则用 STATIONS 表默认值)
METAR_STATIONS=
# METAR 温度偏离预报 >= 此值时视为强信号 (°C)
METAR_DEVIATION_THRESH=3.0
# 极端低估合约阈值: p_market < 此值视为极低估 YES 买入机会
EXTREME_BUY_THRESH=0.05
# METAR 温度直接覆盖预报概率计算 (默认 false, 仅作为独立信号)
METAR_OVERRIDE_ENABLED=false

# === 🏛️ HKO 香港天文台实时温度 (第二独立验证源) ===
# 接入 data.weather.gov.hk 官方 API 获取香港实时气温
# METAR 提前 1-6 小时埋伏, HKO 作为结算前确认信号
HKO_ENABLED=true
# 首选站点: Hong Kong Observatory (天文台总站), Chek Lap Kok (机场), King's Park (京士柏)
HKO_STATION=Hong Kong Observatory

# === 🎯 Fractional Kelly 仓位优化 ===
# 从简单的 edge/100 升级为标准 Kelly 公式 f=(bp-q)/b
KELLY_ENABLED=true
# 各信号类型的 Kelly 分数 (fraction of full Kelly)
# METAR: 0.50 (实时数据更可靠)
# MODEL: 0.25 (预报模型，不确定性中等)
# LADDER: 0.15 (衍生信号，风险最高)
KELLY_FRACTION_METAR=0.50
KELLY_FRACTION_MODEL=0.25
KELLY_FRACTION_LADDER=0.15
# 单笔最大风险限制 (占资本比例, 默认 2%)
KELLY_MAX_RISK_PCT=0.02
# 最小和最大仓位绝对值 ($)
KELLY_MIN_SIZE=1.0
KELLY_MAX_SIZE=100.0

# === ⚙️ v8 保留 信号历史验证闭环（已有） ===
# （见上面注释）
SIGNAL_HISTORY_ENABLED=true
SIGNAL_HISTORY_MIN_WR=0.40
SIGNAL_HISTORY_DAYS=30

# === 🧠 v8: 贝叶斯实时概率更新引擎 ===
# 从 Open-Meteo 采集微观因子（辐射/云量/风速/湿度），
# 对每个温度桶执行贝叶斯更新: 先验×似然→后验概率
# 后验 vs 市场价格偏差 > BAYESIAN_EDGE 时自动触发信号
BAYESIAN_ENABLED=true
# 贝叶斯扫描间隔（秒，默认 600=10分钟）
BAYESIAN_SCAN_INTERVAL=600
# 贝叶斯偏差阈值：后验概率 vs 市场价格偏差 >= 此值触发
BAYESIAN_EDGE=0.08
# 贝叶斯执行冷却（秒，默认 1800=30分钟）
BAYESIAN_COOLDOWN=1800
# 贝叶斯每日执行上限（笔）
BAYESIAN_DAILY_LIMIT=5
# 贝叶斯仓位大小（美元）
BAYESIAN_POSITION_SIZE=50.0
# 似然修正强度 [0.0~1.0]：0=不修正(只用模型概率)，1=完全修正
BAYESIAN_LIKELIHOOD_STRENGTH=0.40

# === 溫度階梯套利 (LADDER) ===
LADDER_ENABLED=true
LADDER_SPREAD=1
LADDER_EDGE_BOOST=1.3
LADDER_SIZE_PCT=0.5

# === #7 實盤階段 ===
# backtest(回測) → observe(信號觀察) → small(小倉$50-100) → full(全倉)
LIVE_MODE_PHASE=backtest

# === 資金 ===
INITIAL_CAPITAL=10000.0

# === 儀表板 ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3002

# ══════════════════════════════════════════════════════════════════
# v9 全优化版 — 10 模块配置
# ══════════════════════════════════════════════════════════════════

# === Module 1: 订单簿微观结构 (CLOB深度+TWAP拆分) ===
V9_MICRO_ENABLED=true
V9_TWAP_SLICES=5
V9_TWAP_MIN_INTERVAL=3.0
V9_TWAP_MAX_INTERVAL=30.0

# === Module 2: 动态止损 (ATR+策略类型自适应) ===
V9_DYNAMIC_STOPS_ENABLED=true
V9_ATR_PERIOD=6
V9_ATR_DEFAULT=0.02

# === Module 3: 多论文自动解析 (arXiv→DeepSeek→策略入库) ===
# 需要 DEEPSEEK_API_KEY 环境变量 (缺省时使用模拟模式)
V9_PAPER_READER_ENABLED=true
V9_PAPER_SCAN_INTERVAL=3600
# DEEPSEEK_API_KEY=sk-...

# === Module 4: 策略组合优化 (实盘表现自动调整权重) ===
V9_PORTFOLIO_ENABLED=true
V9_PORTFOLIO_OPTIMIZE_INTERVAL=3600

# === Module 5: 相关性风控 (策略收益>0.70自动降仓) ===
V9_CORRELATION_ENABLED=true
V9_CORRELATION_CHECK_INTERVAL=1800

# === Module 6: 压力测试 (4场景模拟) ===
V9_STRESS_TEST_ENABLED=true
V9_STRESS_TEST_INTERVAL=21600

# === Module 7: 数据质量监控 (新鲜度/记录数/异常值) ===
V9_DQM_ENABLED=true
V9_DQM_CHECK_INTERVAL=600

# === Module 8: 自动熔断恢复 ===
V9_CIRCUIT_BREAKER_ENABLED=true

# === Module 9: 日报自动发送 (Telegram Bot) ===
V9_REPORTER_ENABLED=true
# Telegram Bot 凭据 (缺省时仅日志输出)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234
# TELEGRAM_CHAT_ID=123456789

# === #8 安全 ===
# 以下密鑰僅在實盤模式 (DRY_RUN=false) 時需要
# 務必通過環境變量或 PM2 env 設置，不要寫入 .env 文件
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PASSPHRASE=
# COMPLIANCE_CONFIRMED=false

# ═══════════════════════════════════════════════════════════════
# 生产级架构 (Day1): 概率校准 + 成本模型 + 组合风控 + FastAPI
# ═══════════════════════════════════════════════════════════════

# === 🎯 概率校准 (calibrator.py, Isotonic Regression) ===
# 把高斯 CDF 原始概率校准为实际频率; 训练数据 = 已结算信号的 (p_model, 结果)
CALIB_ENABLED=true
CALIB_RETRAIN_DAILY=true          # 每日从已结算信号重训一次
CALIB_APPLY_TO=MODEL,LADDER       # 校准应用的信号类型 (ALL=全部; BAYESIAN/METAR/HKO 默认不校准)

# === 💸 交易成本模型 (cost_model.py) ===
# edge_net = |p_model-p_market| - taker_fee - gas - slippage - impact - theta_decay
COST_ENABLED=true
MIN_NET_EDGE=0.03                 # 最小净 edge (低于此值不开仓)
COST_TAKER_FEE=0.002              # 吃单费率 (Polymarket 名义 0, 保守 0.2%)
COST_GAS_PER_SHARE=0.001          # 每股链上 gas 摊薄
COST_SLIPPAGE_COEF=0.02           # 滑点系数 (滑点 = coef × size/depth)
COST_SLIPPAGE_CAP=0.05            # 滑点上限
COST_IMPACT_COEF=0.01             # 冲击系数 (冲击 = coef × size/liquidity)
COST_IMPACT_CAP=0.03              # 冲击上限
COST_THETA_RATE=0.02              # theta 时间衰减速率 (距结算越近衰减越大)
COST_THETA_CAP=0.05               # theta 衰减上限

# === 🛡️ 组合风控 (portfolio_risk.py) ===
# 同事件限制 + 相邻桶限制 + 相关性熔断
RISK_ENABLED=true
RISK_MAX_POS_PER_EVENT=2          # 同一 (城市+日期) 最大持仓笔数
RISK_MAX_EXPOSURE_EVENT=150       # 同一事件最大总暴露金额 $
RISK_MAX_ADJACENT_BUCKETS=2       # 同一事件相邻温度桶最大笔数
RISK_CORR_BREAKER_COUNT=3         # 同事件同向信号 ≥ N 个 → 相关性熔断 (模型系统性偏差)
RISK_CORR_BREAKER_COOLDOWN=3600   # 熔断冷却秒数

# === 🌐 FastAPI 服务器 (api_server.py) ===
# 替代手写 http.server; 自动文档 /docs; 生产指标 /api/metrics + /api/calibration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3002

# ══════════════════════════════════════════════════════════════
# Benjam1nCup 5分钟套利 Bot 子模块 (polymarket_5min_bot)
# 整合: 套利 / 狙击 / 动量 / 阶梯 (Ladder+Stair) 四大策略
# 与天气 Bot 共享风控 (shared_risk) + 统一账户 (account_manager)
# ══════════════════════════════════════════════════════════════

# === 总开关: 集成到 bot.py 主进程 (生产推荐) ===
PM5_ENABLED=true
# 独立运行入口: python -m polymarket_5min_bot
# (调试用; 生产请勿与 PM5_ENABLED=true 同时运行, 避免重复交易)

# === 运行模式 ===
PM5_SCAN_INTERVAL_SEC=15
PM5_TARGET_ASSETS=BTC,ETH
PM5_MARKET_WINDOW_MIN=5
# 真实 5min 市场空缺时回退模拟市场 (DRY_RUN 验证用)
PM5_SIM_MARKETS_ENABLED=true

# === 🧲 套利 (互补套利 Buy1+Buy2, 组合成本→$0.95) ===
PM5_ARB_ENABLED=true
PM5_ARB_MIN_BASE_PRICE=0.55
PM5_ARB_COMBINED_TARGET=0.95
PM5_ARB_MAX_COMBINED=0.97
PM5_ARB_SIZE_USD=10.0
PM5_ARB_MIN_EDGE=0.015
PM5_ARB_LEG2_MAX_WAIT=8

# === 🎯 狙击 (Endcycle Sniper, 结算前锁定) ===
PM5_SNIPER_ENABLED=true
PM5_SNIPER_WINDOW_SEC=45
PM5_SNIPER_PRICE_THRESH=0.95
PM5_SNIPER_MIN_PRICE=0.80
PM5_SNIPER_SIZE_USD=10.0

# === ⚡ 动量 (流动性 OBI + 现货偏离双确认) ===
PM5_MOMENTUM_ENABLED=true
PM5_MOMENTUM_OBI_THRESH=0.35
PM5_MOMENTUM_PRICE_DEV=0.0008
PM5_MOMENTUM_COOLDOWN=45
PM5_MOMENTUM_SIZE_USD=10.0

# === 🪜 阶梯 (Ladder 双向做市 + Stair 分批出场) ===
PM5_LADDER_ENABLED=true
PM5_LADDER_MIN_SPREAD=0.012
PM5_LADDER_SIZE_USD=5.0
PM5_LADDER_STOP_BEFORE_END=20
PM5_STAIR_ENABLED=true
PM5_STAIR_STEPS=3
PM5_STAIR_STEP_OFFSET=0.002

# === 🛡️ 子模块自身风控兜底 (主风控在 shared_risk.py) ===
PM5_MAX_POS_PER_MARKET=2
PM5_MAX_TOTAL_POSITIONS=20

# === 🔐 实盘签名 (DRY_RUN=false 时需要; 缺失时自动降级 DRY_RUN) ===
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PASSPHRASE=
# POLYMARKET_PRIVATE_KEY=
