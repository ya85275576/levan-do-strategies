# ============================================================
# LE VAN DO® 交易所 API 连接配置
# ============================================================
# 使用方式：
#   1. 复制为 .env 文件：cp .env.example .env
#   2. 填入 API Key / Secret / Passphrase（来自 Secrets 页面）
#   3. 启动服务
# ============================================================

# ============================================================
# LE VAN DO® 交易所 API 连接配置
# ============================================================
# 使用方式：
#   1. 复制为 .env 文件：cp .env.example .env
#   2. 填入所需交易所的 API Key / Secret
#   3. 启动服务
# ============================================================

# --- 交易所類型 ---
# okx | mt5
# 預設 okx，切換至 MT5 時請設定為 mt5 並配置下方 MT5 憑證
EXCHANGE_TYPE=okx

# --- 交易环境 ---
# testnet | production
# OKX 模拟盘使用 demo.okx.com 账户 API Key，实盘使用主账户 API Key
EXCHANGE_NETWORK=testnet

# --- OKX API 凭据（三件套认证） ---
# 请通过团队 Secrets 页面添加以下三个密钥：
#   OKX_API_KEY       — API Key
#   OKX_API_SECRET    — Secret Key
#   OKX_API_PASSPHRASE — Passphrase（创建 API Key 时设置）
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- MT5 憑證（僅 EXCHANGE_TYPE=mt5 時使用） ---
# MT5 帳戶需要在交易伺服器端（Windows）先登入並啟用自動交易
# 若在 Linux 執行，請設定 DRY_RUN=true 啟用模擬模式
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=ICMarkets-Demo
# MT5_PATH 為可選的終端 exe 路徑（Windows），留空使用預設路徑
MT5_PATH=

# --- Webhook 安全 ---
# TradingView Webhook 的共享密钥，用于验证请求来源
# 在 TradingView 警报消息中附带此密钥
WEBHOOK_SECRET=your-webhook-secret-here

# --- 服务器 ---
PORT=3000
HOST=0.0.0.0

# --- 交易参数 ---
# 默认订单类型：market | limit
DEFAULT_ORDER_TYPE=market

# 默认杠杆倍数
DEFAULT_LEVERAGE=1

# 仓位模式：isolated | cross
POSITION_MODE=isolated

# --- 模拟模式 ---
# true = 所有操作僅輸出日誌，不實際連接交易所/MT5
# false = 實際下單
DRY_RUN=true
