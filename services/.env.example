# ============================================================
# LE VAN DO® 交易所 API 连接配置
# ============================================================
# 使用方式：
#   1. 复制为 .env 文件：cp .env.example .env
#   2. 填入 API Key 和 Secret（来自 Secrets 页面）
#   3. 启动服务
# ============================================================

# --- 交易环境 ---
# testnet | production
EXCHANGE_NETWORK=testnet

# --- Bybit API 凭据 ---
# 请通过团队 Secrets 页面添加：BYBIT_API_KEY 和 BYBIT_API_SECRET
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Webhook 安全 ---
# TradingView Webhook 的共享密钥，用于验证请求来源
# 在 TradingView 警报消息中附带此密钥
WEBHOOK_SECRET=your-webhook-secret-here

# --- 服务器 ---
PORT=3000
HOST=0.0.0.0

# --- 交易参数 ---
# 默认订单类型：market | limit
DEFAULT_ORDER_TYPE=market

# 默认杠杆倍数（Bybit 统一账户）
DEFAULT_LEVERAGE=1

# 仓位模式：isolated | cross
POSITION_MODE=isolated
